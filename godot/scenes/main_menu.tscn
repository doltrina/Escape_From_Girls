theme_override_font_sizes/font_size = 14
text = "• W, A, S, D — Передвижение
• SHIFT — Спринт (расходует выносливость)
• ПРОБЕЛ — Прыжок / Двойной прыжок (Вулкан)
• F — Фонарик ВКЛ / ВЫКЛ
• Движение мышью — Обзор от 1-го лица
• [1] — 🛡️ RTX 5090 (Силовое Поле, отталкивает девушку)
• [2] — ⚡ Энергетик Flash (Бесконечная выносливость)
• [3] — 🎎 Дакимакура (Приманка, отвлекает на 5 сек)
• [4] — 🎲 D20 Кость (+1 Спас-бросок при поимке)
• ESC — Меню паузы"

